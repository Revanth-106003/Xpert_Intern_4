# ------------------------------------------------------------------
# AI Test Case Generator Agent - environment configuration
# Copy this file to .env and adjust. Never commit .env (it is git-ignored).
# ------------------------------------------------------------------

# LLM provider: "ollama" (local, default) or "gemini" (Google cloud API)
LLM_PROVIDER=ollama

# ---- Ollama (local) ----
# Install from https://ollama.com/download then run:  ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Google Gemini (optional) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ---- Generation tuning ----
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
MAX_TEST_CASES=20
MAX_REPAIR_ATTEMPTS=1

# ---- Storage ----
DATABASE_PATH=data/test_cases.db
